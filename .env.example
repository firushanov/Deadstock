# Elasticsearch Serverless
# Cloud console -> your project -> Help icon (top right) -> Connection details -> Endpoints
ELASTIC_ENDPOINT=https://your-project.es.us-east-1.aws.elastic.cloud

# Cloud console -> your project home -> Create API key (copy immediately, shown once)
ELASTIC_API_KEY=

# Same project as ELASTIC_ENDPOINT, but hostname uses .kb. instead of .es.
# Agent Builder APIs live on Kibana, not Elasticsearch. Do not mix these up.
KIBANA_URL=https://your-project.kb.us-east-1.aws.elastic.cloud

# Apify token: https://console.apify.com/settings/integrations
# Event coupon: ELASTIC_APIFY_HCK_NGHT (grants $50 platform usage tonight)
APIFY_TOKEN=

# Hard cost ceiling per Apify actor call, US dollars. Circuit breaker.
# Coupon is $50 so this can be generous, but keep it -- a runaway loop is a runaway loop.
APIFY_MAX_CHARGE_USD=3.00
